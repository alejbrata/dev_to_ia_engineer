{
	// Entorno del curso en GitHub Codespaces (o en un contenedor local con VS Code).
	// Python 3.12, uv, las dependencias del curso y Ollama con los modelos de los roles
	// `chat` y `embeddings` de config/models.toml. Lección 0.04, "Sin instalar nada".
	"name": "Curso de AI Engineer",
	"image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
	// La máquina de 4 núcleos y 16 GB: con menos, los modelos no caben con holgura.
	"hostRequirements": {
		"cpus": 4,
		"memory": "16gb"
	},
	"containerEnv": {
		// El entorno de Python, fuera del repositorio: así no se mezcla con el de tu equipo
		// si abres la misma carpeta en local y en el contenedor.
		"UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv-curso",
		"UV_LINK_MODE": "copy"
	},
	"remoteEnv": {
		"PATH": "/home/vscode/.local/bin:${containerEnv:PATH}"
	},
	"postCreateCommand": "bash .devcontainer/preparar.sh",
	"postStartCommand": "bash .devcontainer/arrancar.sh",
	"forwardPorts": [11434, 8100],
	"portsAttributes": {
		"11434": { "label": "Ollama", "onAutoForward": "silent" },
		"8100": { "label": "Asistente (módulo 6)", "onAutoForward": "notify" }
	},
	"customizations": {
		"vscode": {
			"extensions": ["ms-python.python", "charliermarsh.ruff"],
			"settings": {
				"python.defaultInterpreterPath": "/home/vscode/.venv-curso/bin/python"
			}
		}
	}
}
