---
// Tarjetas de módulos para la portada. Lee el sidebar generado desde docs/PLAN.md,
// así que se actualiza solo al cambiar el plan.
import { getCollection } from 'astro:content';
import { CardGrid, LinkCard } from '@astrojs/starlight/components';
import sidebar from '../sidebar.json';

const docs = await getCollection('docs');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const modulos = sidebar.map(({ label, items }) => {
	const directory = items[0].autogenerate.directory;
	const lecciones = docs
		.filter((doc) => doc.id.startsWith(`${directory}/`))
		.sort((a, b) => a.id.localeCompare(b.id));
	const [numero, ...nombre] = label.split(' — ');
	// Una página sin escribir lleva el aviso "En preparación" (scripts/plan_sync.py).
	const escritas = lecciones.filter((doc) => !doc.body?.includes(':::note[En preparación]')).length;
	const estado =
		escritas === lecciones.length
			? `${lecciones.length} lecciones`
			: escritas === 0
				? `${lecciones.length} lecciones · en preparación`
				: `${escritas} de ${lecciones.length} lecciones escritas`;
	return {
		title: nombre.length ? nombre.join(' — ') : label,
		description: nombre.length ? `${numero} · ${estado}` : `${lecciones.length} anexos`,
		href: `${base}/${lecciones[0]?.id ?? directory}/`,
	};
});
---

<CardGrid>
	{modulos.map((m) => <LinkCard title={m.title} description={m.description} href={m.href} />)}
</CardGrid>
