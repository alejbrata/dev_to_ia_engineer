---
// El ciclo de trabajo del curso: construir, medir, depurar, desplegar y vuelta a medir.
// Cada fase dice qué hace en el curso, con sus herramientas concretas.
const fases = [
	{ nombre: 'Construir', que: 'Código que funciona desde la primera lección.' },
	{ nombre: 'Medir', que: 'Tokens, latencia, coste y errores en cada llamada.' },
	{ nombre: 'Depurar', que: 'Errores reales, leídos de la traza a la causa.' },
	{ nombre: 'Desplegar', que: 'Producción, y vuelta a medir.' },
];
---

<section class="ciclo not-content" aria-label="El ciclo de trabajo del curso">
	<svg viewBox="0 0 320 320" aria-hidden="true">
		<circle cx="160" cy="160" r="110" class="anillo"></circle>
		<circle cx="160" cy="160" r="110" class="pulso"></circle>
		{
			fases.map((fase, i) => {
				const angulo = (i * Math.PI) / 2 - Math.PI / 2;
				const x = 160 + 110 * Math.cos(angulo);
				const y = 160 + 110 * Math.sin(angulo);
				return (
					<g class="nodo">
						<circle cx={x} cy={y} r="44" />
						<text x={x} y={y + 5}>
							{fase.nombre}
						</text>
					</g>
				);
			})
		}
	</svg>
	<ol>
		{
			fases.map(({ nombre, que }) => (
				<li>
					<b>{nombre}.</b> {que}
				</li>
			))
		}
	</ol>
</section>

<style>
	.ciclo {
		display: grid;
		gap: 2rem;
		align-items: center;
		margin-block: 2rem;
	}

	@media (min-width: 50rem) {
		.ciclo {
			grid-template-columns: 18rem 1fr;
		}
	}

	svg {
		width: min(100%, 18rem);
		height: auto;
		margin-inline: auto;
	}

	.anillo {
		fill: none;
		stroke: var(--sl-color-gray-5);
		stroke-width: 2;
		stroke-dasharray: 6 8;
	}

	/* Un tramo de luz que recorre el anillo: el ciclo no termina. */
	.pulso {
		fill: none;
		stroke: var(--sl-color-accent);
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-dasharray: 90 601;
		transform-origin: 160px 160px;
		animation: girar 9s linear infinite;
	}

	@keyframes girar {
		to {
			transform: rotate(360deg);
		}
	}

	.nodo circle {
		fill: var(--sl-color-black);
		stroke: var(--sl-color-accent);
		stroke-width: 2;
	}

	.nodo text {
		fill: var(--sl-color-white);
		font-family: var(--sl-font-mono);
		font-size: 13px;
		font-weight: 500;
		text-anchor: middle;
	}

	ol {
		margin: 0;
		padding-inline-start: 2rem;
		color: var(--sl-color-gray-2);
	}

	li + li {
		margin-top: 0.6rem;
	}

	li b {
		color: var(--sl-color-white);
		font-weight: 600;
	}

	li::marker {
		font-family: var(--sl-font-mono);
		color: var(--sl-color-accent);
	}

	@media (prefers-reduced-motion: reduce) {
		.pulso {
			animation: none;
		}
	}
</style>
