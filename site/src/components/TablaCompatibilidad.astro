---
// Todas las prácticas del curso frente a cada API comercial: el resultado real de
// `modulos/g-apis-comerciales/compatibilidad.py`, que es quien rellena el JSON.
import datos from '../../../modulos/g-apis-comerciales/resultados/compatibilidad.json';

type Resultado = { estado: string };
const resultados = datos.resultados as Record<string, Record<string, Resultado>>;
const PROVEEDORES = [
	['openai', 'OpenAI'],
	['hf', 'Hugging Face'],
	['claude', 'Claude'],
] as const;
const ETIQUETAS: Record<string, string> = {
	funciona: 'funciona',
	'sin clave': 'sin probar',
	'sin logprobs': 'no da logprobs',
	'solo local': 'no lo usa',
	'necesita previa': 'necesita la previa',
	falla: 'falla',
	'tiempo agotado': 'no termina',
};
// Las que no llaman a ningún modelo (comprobar el entorno, trocear texto...) no cuentan.
const llamaAModelos = (fila: Record<string, Resultado>) =>
	Object.values(fila).some((r) => r.estado !== 'sin modelos');
const filas = Object.entries(resultados)
	.filter(([, fila]) => llamaAModelos(fila))
	.sort(([a], [b]) => a.localeCompare(b))
	.map(([practica, fila]) => ({ practica: practica.replace(/^modulos\//, ''), fila }));
const cuenta = (proveedor: string) =>
	filas.filter(({ fila }) => fila[proveedor]?.estado === 'funciona').length;
---

<div class="tabla-compatibilidad not-content">
	<table>
		<thead>
			<tr>
				<th>Práctica</th>
				{PROVEEDORES.map(([, nombre]) => <th>{nombre}</th>)}
			</tr>
		</thead>
		<tbody>
			{
				filas.map(({ practica, fila }) => (
					<tr>
						<td><code>{practica}</code></td>
						{PROVEEDORES.map(([clave]) => {
							const estado = fila[clave]?.estado ?? '-';
							return <td data-estado={estado}>{ETIQUETAS[estado] ?? estado}</td>;
						})}
					</tr>
				))
			}
		</tbody>
		<tfoot>
			<tr>
				<td>Funcionan</td>
				{PROVEEDORES.map(([clave]) => <td>{cuenta(clave)} de {filas.length}</td>)}
			</tr>
		</tfoot>
	</table>
</div>

<style>
	.tabla-compatibilidad {
		overflow-x: auto;
		margin-block: 1rem;
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--sl-text-sm);
	}
	th,
	td {
		text-align: start;
		padding: 0.25rem 0.5rem;
		border-bottom: 1px solid var(--sl-color-gray-5);
		white-space: nowrap;
	}
	tfoot td {
		font-weight: 600;
	}
	td[data-estado='funciona'] {
		color: var(--sl-color-green-high, inherit);
	}
	td[data-estado='falla'],
	td[data-estado='tiempo agotado'] {
		color: var(--sl-color-red-high, inherit);
	}
</style>
