# Copia este fichero a .env y rellena solo lo que vayas a usar.
# .env está en .gitignore: nunca lo subas al repo.

# --- Proveedores de LLM ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Hugging Face: descargar modelos y llamar a Inference Providers. Para llamar a
# Inference Providers la cuenta necesita créditos (las gratuitas no los incluyen):
# sin ellos, el token es válido pero las llamadas fallan.
HF_TOKEN=

# --- Bases de datos locales (compose.yaml) ---
PGVECTOR_URL=postgresql://curso:curso@127.0.0.1:5433/curso

# --- Observabilidad ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
