{
  // Ctrl+Shift+P → "Tasks: Run Task" → elige una "Curso: ...".
  // Todas se ejecutan en la raíz del repo, con el entorno de uv.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Curso: ejecutar el script abierto",
      "type": "shell",
      "command": "uv run python \"${file}\"",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Curso: comprobar entorno",
      "type": "shell",
      "command": "uv run python modulos/00-introduccion/comprobar_entorno.py",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Curso: tests",
      "type": "shell",
      "command": "uv run pytest",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Curso: lint (ruff)",
      "type": "shell",
      "command": "uv run ruff check",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    }
  ]
}
